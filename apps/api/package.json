{
  "name": "@lumen/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration"
  },
  "dependencies": {
    "@lumen/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "pg": "^8.23.1",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.0",
    "prisma": "7.10.0",
    "supertest": "^7.1.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
