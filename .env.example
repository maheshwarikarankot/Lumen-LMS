NODE_ENV=development

# Postgres (docker-compose.yml reads these)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=lumen_db
POSTGRES_PORT=5432


# API
API_PORT=4000
# silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Must agree with the POSTGRES_* values above (user:password@host:port/db)
DATABASE_URL=postgresql://postgres:password@localhost:5432/lumen_db
# Signs the 15-minute access tokens. 32+ random characters: openssl rand -base64 48
# Changing it invalidates everyone's current access token.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-0000

# Tests
# Optional. Integration tests default to DATABASE_URL with the database name lumen_test.
# The name must end in _test — the helpers refuse to wipe anything else.
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/lumen_test

# Web
# Where the Next.js server (and its /api proxy) reaches the API
API_URL=http://localhost:4000
